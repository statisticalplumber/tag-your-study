# Required for server-side Gemini AI (admin role only).
# Users with the 'user' role supply their own key in the app settings.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Password for the admin role login
ADMIN_PASSWORD="your_admin_password"

# Password for the user role login
USER_PASSWORD="your_user_password"

# Secret used to sign session tokens — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"
